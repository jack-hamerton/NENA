
PROJECT_NAME="Nena"
API_V1_STR="/api/v1"

# Database
POSTGRES_SERVER="your_postgres_server"
POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="your_postgres_db"
DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@your_postgres_server/your_postgres_db"

# Security
SECRET_KEY="your_secret_key"
ALGORITHM="your_algorithm"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST="your_redis_host"
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS="your_kafka_bootstrap_servers"

# S3
S3_ENDPOINT_URL="your_ix_africa_endpoint_url"
S3_ACCESS_KEY_ID="your_ix_africa_access_key_id"
S3_SECRET_ACCESS_KEY="your_ix_africa_secret_access_key"
S3_BUCKET_NAME="your_ix_africa_bucket_name"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
