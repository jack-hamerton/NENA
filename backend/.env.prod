# Production Environment Variables
PROJECT_NAME=NENA
API_V1_STR=/api/v1

# Database
POSTGRES_SERVER=db
POSTGRES_USER=nena_user
POSTGRES_PASSWORD=nena_password
POSTGRES_DB=nena_db
DATABASE_URL=postgresql://nena_user:nena_password@db:5432/nena_db

# Security
SECRET_KEY=your-production-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# CORS
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:80", "https://yourdomain.com"]

# Production settings
DEBUG=False
TESTING=False